{
  "name": "trip-planner",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:test": "NEXT_PUBLIC_E2E=1 next build --webpack && next start",
    "build": "next build --webpack",
    "start": "next start",
    "format": "prettier --check app components data lib tests/web tests/e2e *.ts *.mjs package*.json public/sw.js",
    "format:write": "prettier --write app components data lib tests/web tests/e2e *.ts *.mjs package*.json public/sw.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:web": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:web:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:e2e": "playwright test",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@serwist/next": "^9.2.1",
    "@upstash/redis": "^1.35.8",
    "next": "^16.1.6",
    "openai": "^7.10.0",
    "serwist": "^9.2.1",
    "swr": "^2.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "browserslist": "^4.28.8"
  }
}
