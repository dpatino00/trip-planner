# Production persistence
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private trip catalog (server-only; encryption key is 32 random bytes base64url encoded)
TRIP_CATALOG_PASSWORD=
TRIP_CATALOG_SESSION_SECRET=
TRIP_CATALOG_ENCRYPTION_KEY=

# Shared secret configured as the Custom GPT Action API key (32+ bytes)
TRIP_GPT_ACTION_KEY=

# Private trip token bound server-side to this one-trip Custom GPT
TRIP_GPT_TRIP_TOKEN=

# Server-only embedded Ask configuration (OPENAI_MODEL must support web search)
OPENAI_API_KEY=
OPENAI_MODEL=
